{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuki.invalid/schemas/training-dataset-manifest.schema.json",
  "title": "Yuki training dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "hub_repository",
    "revision",
    "license",
    "source_url",
    "retrieved_at",
    "splits",
    "intended_use",
    "content_sha256",
    "privacy_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$"
    },
    "hub_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}/[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx_id",
        "review_status",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "spdx_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "review_status": {
          "enum": [
            "approved",
            "rejected",
            "pending"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://huggingface\\.co/datasets/"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "intended_use": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "contains_personal_data",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "rejected",
            "pending"
          ]
        },
        "contains_personal_data": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
