[Unit]
Description=Yuki PostgreSQL schema migration (one-shot deployment job)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=yuki-migrate
Group=yuki-migrate
WorkingDirectory=/opt/yuki/current
# Provision the source file root:root with mode 0600.
LoadCredential=database-url:/etc/yuki/credentials/migrate-database-url
ExecStart=/opt/yuki/venv/bin/yuki-db-migrate --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
