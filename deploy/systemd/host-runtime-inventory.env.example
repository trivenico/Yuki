# Install as root-owned /etc/yuki/host-runtime-inventory.env (mode 0640).
# Replace every example value with the actual service account and deployment.
YUKI_HOST_INVENTORY_SOCKET=/run/yuki-host-inventory/agent.sock
YUKI_HOST_INVENTORY_KEY_FILE=/etc/yuki/host-runtime-inventory.key
YUKI_HOST_INVENTORY_SOURCE_ID=yuki-host-primary
YUKI_HOST_INVENTORY_SERVICE_UID=991
YUKI_HOST_INVENTORY_SOCKET_GID=992
YUKI_HOST_INVENTORY_CLIENT_UID=1001
# Must point to trusted, installed operator code returning a collector callable.
YUKI_HOST_INVENTORY_COLLECTOR_FACTORY=core.host_runtime_inventory_sbom_factory:build_collector
# Provision this directory root-controlled, service-readable and read-only (0500).
YUKI_HOST_INVENTORY_SBOM_DIRECTORY=/etc/yuki/sbom
# Separate publisher HMAC key, owned by the service UID with mode 0400.
YUKI_HOST_INVENTORY_SBOM_PUBLISHER_KEY_FILE=/etc/yuki/sbom-publisher.key
# Required trusted host-side observer; must inspect the live container without task commands.
YUKI_HOST_INVENTORY_RUNTIME_OBSERVER=core.linux_runtime_filesystem_observer:build_observer
YUKI_HOST_INVENTORY_PROC_ROOT=/proc
