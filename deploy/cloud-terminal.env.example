# Optional hybrid provider settings. Never put secret values in this file.
# Export these in your shell or inject them through a cloud secret manager.
YUKI_PROVIDER=hybrid
YUKI_OLLAMA_MODEL=
YUKI_CLOUD_MODEL=
YUKI_CLOUD_TASKS=
YUKI_CLOUD_API_KEY_ENV=OPENAI_API_KEY
# Store the actual OPENAI_API_KEY only in the environment/secret manager.