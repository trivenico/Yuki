# Copy to .env for local use if your launcher loads it.
# Never commit .env or real credentials.
YUKI_WORKSPACE=./yuki_workspace
YUKI_PROVIDER=mock
YUKI_OLLAMA_BASE_URL=http://127.0.0.1:11434
YUKI_OLLAMA_MODEL=
# Voice remains disabled until a consent-based voice adapter is implemented.
YUKI_VOICE_ENABLED=false
