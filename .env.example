# Copy values into your launch environment if needed.
# Never commit real credentials.
YUKI_WORKSPACE=./yuki_workspace
YUKI_PROVIDER=mock
YUKI_OLLAMA_BASE_URL=http://127.0.0.1:11434
YUKI_OLLAMA_MODEL=
YUKI_CLOUD_MODEL=
YUKI_CLOUD_TASKS=
YUKI_CLOUD_API_KEY_ENV=OPENAI_API_KEY
YUKI_CLOUD_BASE_URL=https://api.openai.com/v1
YUKI_VOICE_ENABLED=false
YUKI_SECURITY_LAB_ENABLED=false
YUKI_SANDBOX_ENABLED=false
YUKI_WAKEWORD_ENABLED=false
YUKI_GMAIL_ENABLED=false
YUKI_FIREWALL_ENABLED=false
YUKI_FIREWALL_DRY_RUN=true
