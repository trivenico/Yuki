# Copy values into your launch environment if needed; the app does not auto-load .env.
# Never commit real credentials.
YUKI_WORKSPACE=./yuki_workspace
YUKI_PROVIDER=openai
YUKI_OPENAI_MODEL=gpt-4.1-mini
# Optional: YUKI_OPENAI_BASE_URL=https://api.openai.com/v1
# Set OPENAI_API_KEY in your shell/secret manager; never commit it.
YUKI_OLLAMA_BASE_URL=http://127.0.0.1:11434
YUKI_OLLAMA_MODEL=
# Optional Colibri local inference (install and start Colibri separately)
# YUKI_PROVIDER=colibri
# YUKI_COLIBRI_MODEL=your-installed-model-id
# YUKI_COLIBRI_BASE_URL=http://127.0.0.1:8000/v1
YUKI_VOICE_ENABLED=false
YUKI_SECURITY_LAB_ENABLED=false
YUKI_SANDBOX_ENABLED=false
YUKI_WAKEWORD_ENABLED=false
YUKI_GMAIL_ENABLED=false
YUKI_FIREWALL_ENABLED=false
YUKI_FIREWALL_DRY_RUN=true
YUKI_SANDBOX_ENABLED=false
